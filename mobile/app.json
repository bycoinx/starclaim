{
  "expo": {
    "name": "StarCalimX Mobile",
    "slug": "starcalimx-mobile",
    "version": "1.0.0",
    "icon": "./assets/starcalimx-logo.png",
    "userInterfaceStyle": "dark",
    "orientation": "landscape",
    "scheme": "starcalimx",
    "splash": {
      "image": "./assets/starcalimx-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/starcalimx-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.mobile"
    },
    "androidNavigationBar": {
      "backgroundColor": "#02040A",
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "web": {
      "favicon": "./assets/starcalimx-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "StarCalimX, bulundugunuz yerden gorunen gercek gokyuzunu hesaplamak icin konumunuzu kullanir."
        }
      ]
    ]
  }
}
